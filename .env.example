# CivicPulse API - Environment Configuration

# Flask Application Settings
SECRET_KEY=civicpulse-secret-key-super-secure-dev
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# =======================================================
# SUPABASE CONFIGURATION
# =======================================================
# 1. SUPABASE_URL: Found in Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# 2. SUPABASE_KEY: Found in Project Settings -> API -> Project API Keys
# Recommended: Use the 'service_role' key (secret) for server-side operations (bypasses RLS).
# Or use the 'anon' (public) key if RLS policies are configured.
SUPABASE_KEY=your-supabase-service-role-or-anon-key-here

# Optional: Direct PostgreSQL connection string (Project Settings -> Database -> Connection string)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres
